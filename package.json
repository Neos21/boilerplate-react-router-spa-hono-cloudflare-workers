{
  "name": "boilerplate-react-router-spa-hono-cloudflare-workers",
  "description": "Boilerplate : React Router (SPA) + Hono + Cloudflare Workers",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --host",
    "test": "vitest run --coverage",
