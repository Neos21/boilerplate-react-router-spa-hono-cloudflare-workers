    "generate-types": "wrangler types && react-router typegen",
    "build": "npm run generate-types && tsc && react-router build",
    "build-only": "react-router build",
    "preview": "npm run build && wrangler dev",
    "preview-only": "wrangler dev",
    "deploy": "npm run build && wrangler deploy",
    "deploy-only": "wrangler deploy",
    "eslint": "eslint",
    "tsc": "tsc",
    "wrangler": "wrangler"
  },
